<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- The Windows media API (what plays in Spotify or a browser, for Discord) exists since 1809. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GameDeck</AssemblyName>
    <RootNamespace>GameDeck.App</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Generated by tools/GameDeck.IconGen from the default logo. -->
    <ApplicationIcon>GameDeck.ico</ApplicationIcon>
    <Version>0.1.1</Version>
    <Authors>kalinvisuals</Authors>
    <Product>GameDeck</Product>
    <Copyright>Copyright (C) 2026 kalinvisuals. Licensed under GPL-3.0-or-later.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <ProjectReference Include="..\GameDeck.Core\GameDeck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameDeck.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built from /web by `npm run build`. -->
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The browser extension, installed from this folder in Chrome or Edge. -->
    <Content Include="..\..\extension\**" Link="extension\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
