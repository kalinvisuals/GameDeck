{
  "manifest_version": 3,
  "name": "GameDeck YouTube",
  "version": "0.4.0",
  "description": "Controls the YouTube tab open in this browser from GameDeck on this PC.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "GameDeck YouTube",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "host_permissions": ["http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
